{% if site.news != blank %}
  <div class="news">
    {% if site.news_limit %}
      {% assign news_limit = site.news_limit %}
    {% else %}
      {% assign news_limit = site.news | size %}
    {% endif %}
    <div class="table-responsive" {% if site.news_scrollable and news_limit > 3 %}style="max-height: 60vw"{% endif %}>
      <table class="table table-sm table-borderless">
        {% assign news = site.news | sort: 'date' | reverse %}
        {% for item in news limit: news_limit %}
          <tr>
            <th scope="row" style="width: 20%">
              {% if item.inline_date %}
                {{ item.inline_date }}
              {% else %}
                {{ item.date | date: '%b %d, %Y' }}
              {% endif %}
            </th>
            <td>
              {% if item.inline %}
                {{ item.content | remove: '<p>' | remove: '</p>' | strip }}
              {% else %}
                <a class="news-title" href="{{ item.url | relative_url }}">{{ item.title }}</a>
              {% endif %}
            </td>
          </tr>
        {% endfor %}
      </table>
    </div>
  </div>
{% else %}
  <p>No news so far...</p>
{% endif %}
